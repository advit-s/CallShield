# CallShield AI Configuration v2.4.0
APP_NAME=CallShield AI
APP_VERSION=2.4.0

# Server network settings
HOST=0.0.0.0
PORT=8000

# Operational flags
CALLSHIELD_DEBUG=false
STORE_TRANSCRIPTS=false

# Security keys (Please override with secure values in production)
CALLSHIELD_PHONE_PEPPER=change-this-secret-pepper-string
CALLSHIELD_ADMIN_KEY=change-this-secret-admin-key-string

# Allowed origins for CORS (comma-separated list, e.g., http://localhost:8000,http://127.0.0.1:8000)
CALLSHIELD_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
